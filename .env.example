# Copie este arquivo para ".env" e ajuste os valores antes de rodar o sistema

# Porta em que o servidor vai rodar
PORT=3000

# Chave secreta usada para assinar os tokens de login (JWT).
# Troque por um valor longo e aleatório em produção.
JWT_SECRET=troque-esta-chave-por-uma-bem-grande-e-aleatoria

# Dados do usuário administrador criado automaticamente na primeira execução
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=admin123

# Pasta do servidor que será monitorada e indexada automaticamente.
# Pode ser um caminho local ou uma pasta de rede montada no servidor
# (ex: um drive compartilhado). Arquivos colocados/removidos aqui são
# detectados automaticamente e ficam disponíveis para vincular a tarefas.
# Exemplos:
#   Windows: C:\Compartilhado\Projetos
#   Linux/Mac: /mnt/compartilhado/projetos
WATCHED_FOLDER=./watched-files

# (Opcional) Caminho padrão da planilha usada por "npm run import-empresas"
# quando você não informar o caminho na linha de comando.
EMPRESAS_XLSX_PATH=./planilha.xlsx
